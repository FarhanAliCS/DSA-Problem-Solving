def miximum_window_start_index(numbers , k):
    if k <= 0 or k > len(numbers) :
        return None
    current_sum=sum(numbers[:k])
    maximum=current_sum
    start_index=0
    for i in range(k , len(numbers)):
        current_sum = current_sum - numbers[i - k] + numbers[i]

        if current_sum > maximum:
            maximum=current_sum
            start_index=i-k+1

    return start_index

    

   

numbers = [2, 1, 5, 1, 3, 2]
k = 3
print(miximum_window_start_index(numbers , k))