class Node:
    def __init__(self, data):
        self.data = data
        self.children = []


def add_children(node):
    number = int(input(f"How many children for {node.data}? "))

    for i in range(number):
        value = int(input(f"Enter child {i+1}: "))

        new_node = Node(value)

        node.children.append(new_node)

        
        add_children(new_node)


def tree():
    value = int(input("Enter root value: "))
    root = Node(value)

    add_children(root)

    return root


def traverse(node):
    if node is None:
        return

    print(node.data)

    for child in node.children:
        traverse(child)


root = tree()

print("\nTree Traversal:")
traverse(root)