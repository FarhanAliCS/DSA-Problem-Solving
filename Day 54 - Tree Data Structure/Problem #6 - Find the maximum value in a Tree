class Node:
    def __init__(self,data):
        self.data=data
        self.children=[]

def tree():
    root=Node(10)
    root.children.append(Node(20))
    root.children.append(Node(30))
    root.children[0].children.append(Node(40))
    root.children[0].children.append(Node(50))
    return root

def maximum_value(node):
    if node is None:
        return float("-inf")

    maximum=float("-inf")
    maximum=max(maximum , node.data)
    for child in node.children:
        maximum=max(maximum , maximum_value(child))

    return maximum

root=tree()
print("Maximum value :",maximum_value(root))
