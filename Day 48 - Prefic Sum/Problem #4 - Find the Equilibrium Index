
def equilibrium_index(numbers):
    if len(numbers) <= 0:
        return None

    total_sum = sum(numbers)
    left_sum = 0

    for i in range(len(numbers)):
        right_sum = total_sum - left_sum - numbers[i]

        if left_sum == right_sum:
            return i

        left_sum += numbers[i]

    return -1


numbers = [1, 3, 5, 2, 2]
print(equilibrium_index(numbers))