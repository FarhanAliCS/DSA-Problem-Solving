def range_sum_queries_with_prefix_sum(numbers , queries):
    if len(numbers) <=  0:
        return None

    total=0
    prefix=[]
    total_sum=0
    result=[]
    for num in numbers :
        total+=num
        prefix.append(total)

    for left , right in queries:
        if left < 0 or right >= len(numbers) or left > right:
            result.append(None)
            continue
        if left == 0 :
            result.append(prefix[right])
        else:
            total_sum = prefix[right] - prefix[left - 1]
            result.append(total_sum)

    return result
            
            
numbers = [4, 2, 7, 1, 3, 6]

queries = [(0, 2), (2, 4), (1, 5), (3, 3),(2,10)]
print(range_sum_queries_with_prefix_sum(numbers , queries))