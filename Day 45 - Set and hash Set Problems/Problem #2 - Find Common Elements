def common_element(list1 , list2):
    common=[]
    list2=set(list2)
    
    for  i in range(len(list1)):
        if list1[i] in list2 and list1[i] not in common:
            common.append(list1[i])


    return common

list1 = [1, 2, 3, 4, 5]
list2 = [3, 4, 4, 5, 6]

print(common_element(list1,list2))