
def find_unique_pairs(numbers, target):
    left = 0
    right = len(numbers) - 1
    unique_pairs = []

    while left < right:
        total = numbers[left] + numbers[right]

        if total > target:
            right -= 1

        elif total < target:
            left += 1

        else:
            unique_pairs.append((numbers[left], numbers[right]))

            left_value = numbers[left]
            right_value = numbers[right]

            while left < right and numbers[left] == left_value:
                left += 1

            while left < right and numbers[right] == right_value:
                right -= 1

    return unique_pairs


numbers = [1, 1, 2, 2, 3, 3, 4, 5, 6]
target = 5

print(find_unique_pairs(numbers, target))