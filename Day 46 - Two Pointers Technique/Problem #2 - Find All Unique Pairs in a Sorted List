def unique_pairs(numbers , target):
    left=0
    right=len(numbers)-1
    total=0
    unique_pairs=[]
    while left < right :
        total = numbers[left] + numbers[right]
        if total > target :
            right-=1
        elif total < target :
            left += 1
        else:
            unique_pairs.append((numbers[left],numbers[right]))
            left+=1
            right-=1


    return unique_pairs

numbers=[1,2,3,4,5,6,7,8]
target=5
print(unique_pairs(numbers , target))

